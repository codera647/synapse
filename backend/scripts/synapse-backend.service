[Unit]
Description=Synapse Backend (FastAPI + worker pool)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Adjust to your host. On GCP Ubuntu the default login user varies; the AWS
# Ubuntu AMI uses "ubuntu".
User=ubuntu
Group=ubuntu

# Repo layout: /opt/synapse is the repo root; the backend lives in backend/.
# WorkingDirectory MUST be the backend/ dir because modules use flat imports
# (e.g. `from hardware import ...`), so uvicorn is launched as `app:app`.
WorkingDirectory=/opt/synapse/backend

# Secrets/config live outside the repo and are injected as environment.
EnvironmentFile=/etc/synapse/backend.env

# Unbuffered logs + a stable HuggingFace model cache on disk (download once,
# survive restarts instead of re-downloading like Colab did every session).
Environment=PYTHONUNBUFFERED=1
Environment=HF_HOME=/opt/synapse/.hf-cache

# Launch uvicorn from the venv, pointing at app:app (NOT backend.app:app).
ExecStart=/opt/synapse/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000

Restart=always
RestartSec=3

# Give the worker pool time to stop its child processes cleanly on shutdown.
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
