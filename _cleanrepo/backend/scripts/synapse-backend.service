[Unit]
Description=Synapse Backend (FastAPI + worker pool)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/synapse

# Store secrets/env outside the repo (recommended).
EnvironmentFile=/etc/synapse/backend.env

# Prevent Python from buffering logs.
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/synapse/.venv/bin/uvicorn backend.app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

